# This folder holds a whole modding workspace. Only the Sprite Porter projects are tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/spriteporter/
!/spriteporter-mod/

bin/
obj/
publish/
__pycache__/

# generated by build_data.py; everything the tool needs is inside data.zip, the mod only needs characters.json
/spriteporter/data/*
!/spriteporter/data/characters.json
